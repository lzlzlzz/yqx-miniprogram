<view class="page">
  <view class="profile">
    <view class="avatar">
      <image wx:if="{{isLoggedIn && user.avatarUrl}}" src="{{user.avatarUrl}}" mode="aspectFill" />
      <text wx:else>{{avatarText}}</text>
    </view>

    <view class="profile-main">
      <block wx:if="{{isLoggedIn}}">
        <view class="name">{{user.nickname || '微信用户'}}</view>
        <view class="profile-sub">
          <text class="profile-sub-label">{{profileSubLabel}}</text>
          <text class="profile-sub-value">{{profileSubValue}}</text>
        </view>

        <view class="phone-card">
          <view class="phone-number">{{phone || '暂未绑定手机号'}}</view>
          <view class="phone-hint">{{phoneHint}}</view>
          <button
            wx:if="{{!phone}}"
            class="bind-phone-button"
            open-type="getPhoneNumber"
            bindgetphonenumber="loginWithPhone"
            loading="{{loginLoading}}"
            disabled="{{loginLoading}}"
          >
            绑定微信手机号
          </button>
        </view>

        <view class="member-grid">
          <view class="member-item">
            <view class="member-label">培训权限</view>
            <view class="member-value">{{levelLabel}}</view>
          </view>
          <view class="member-item">
            <view class="member-label">关联微信</view>
            <view class="member-value">{{wechatBindingText}}</view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="name">立即登录</view>
        <view class="login-subtitle">登录后查看培训内容</view>
        <button
          class="login-button"
          open-type="getPhoneNumber"
          bindgetphonenumber="loginWithPhone"
          loading="{{loginLoading}}"
          disabled="{{loginLoading}}"
        >
          申请获取并验证手机号
        </button>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-title">培训授权</view>

    <view class="field">
      <view class="label">授权码</view>
      <input class="input" value="{{redeemCode}}" bindinput="onRedeemInput" placeholder="请输入培训授权码" />
    </view>

    <button class="primary-button save-button" loading="{{redeeming}}" disabled="{{redeeming}}" bindtap="redeemCode">确认授权</button>
  </view>

  <view class="section">
    <view class="section-title">我的培训</view>
    <view wx:if="{{coursesLoading}}" class="empty">培训内容加载中...</view>
    <view wx:if="{{!coursesLoading && courses.length === 0}}" class="empty">暂无已授权培训内容</view>
    <view
      wx:if="{{!coursesLoading && courses.length > 0}}"
      wx:for="{{courses}}"
      wx:key="_id"
      class="my-course"
      bindtap="goCourse"
      data-id="{{item._id}}"
    >
      <view>
        <view class="my-course-title">{{item.title}}</view>
        <view class="my-course-meta">内部培训</view>
      </view>
      <view class="my-course-action">学习</view>
    </view>
  </view>

  <view class="section service-section">
    <view class="section-title">服务与说明</view>
    <view class="service-row" bindtap="goAbout">
      <view>
        <view class="service-title">培训服务说明</view>
        <view class="service-desc">内部培训与课件资料说明</view>
      </view>
      <view class="service-arrow">›</view>
    </view>
  </view>
</view>
