<view class="page">
  <view class="hero">
    <image class="hero-logo" src="/assets/brand-logo.png" mode="aspectFill" />
      <view>
      <view class="hero-title">易启学</view>
      <view class="hero-subtitle">内部培训学习平台</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">课程加载中...</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{courses.length === 0}}" class="empty">暂无可用培训内容</view>

  <view wx:else class="course-list">
    <view
      wx:for="{{courses}}"
      wx:key="_id"
      class="course-card"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <image
        wx:if="{{item.coverUrl && !item.coverLoadError}}"
        class="course-cover"
        src="{{item.coverUrl}}"
        mode="aspectFill"
        data-index="{{index}}"
        binderror="onCoverError"
      />
      <view wx:else class="course-cover course-cover-placeholder">
        <text>暂无封面</text>
      </view>
      <view class="course-body">
        <view class="course-title">{{item.title}}</view>
        <view class="course-subtitle">{{item.subtitle || '内部培训内容'}}</view>
        <view class="course-footer">
          <text class="course-action">{{item.hasAccess ? '进入学习' : '查看课程'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
