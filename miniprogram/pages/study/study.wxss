.study-page {
  height: 100vh;
  overflow: hidden;
  background: #f6f7f9;
}

.study-shell {
  height: 100vh;
  overflow: hidden;
}

.study-shell.portrait-mode {
  display: flex;
  flex-direction: column;
}

.video-column {
  background: #111827;
}

.video-panel {
  z-index: 2;
  padding: 20rpx 20rpx 18rpx;
  background: #111827;
}

.study-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.toolbar-title {
  flex: 1;
  min-width: 0;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.materials-toggle {
  flex: 0 0 auto;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 24rpx;
  line-height: 56rpx;
}

.materials-toggle::after {
  border: 0;
}

.video-frame {
  position: relative;
}

.video {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: 12rpx;
  background: #000;
}

.video-placeholder {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 420rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #0b3a75, #172033 58%, #4f3f25);
  color: #fff;
  font-size: 28rpx;
}

.video-tools {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  gap: 12rpx;
}

.video-tool-button {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
  line-height: 56rpx;
}

.video-tool-button::after {
  border: 0;
}

.video-settings {
  position: absolute;
  right: 18rpx;
  bottom: 88rpx;
  left: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(17, 24, 39, 0.92);
  color: #fff;
}

.study-shell.portrait-mode .video-tools {
  top: 18rpx;
  bottom: auto;
}

.study-shell.portrait-mode .video-settings {
  top: 88rpx;
  bottom: auto;
}

.setting-row {
  display: flex;
  align-items: center;
  min-height: 64rpx;
  gap: 14rpx;
}

.setting-label {
  width: 72rpx;
  flex: 0 0 72rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.setting-slider {
  flex: 1;
  min-width: 0;
}

.setting-value {
  width: 86rpx;
  flex: 0 0 86rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  text-align: right;
}

.play-mark {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  text-align: center;
  line-height: 92rpx;
  font-size: 42rpx;
}

.content-panel {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 28rpx;
}

.chapter-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.chapter-subtitle {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.note-block,
.link-block,
.download-section {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #fff;
}

.note-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.note-text {
  margin-top: 12rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.7;
}

.note-image {
  width: 100%;
  margin-top: 18rpx;
  border-radius: 10rpx;
  background: #e5e7eb;
}

.pinch-zoom-container {
  width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  min-height: 100rpx;
}

.pinch-image {
  display: block;
  width: 100%;
  border-radius: 10rpx;
  background: #e5e7eb;
}

.note-caption {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.link-block {
  display: block;
}

.link-content {
  min-width: 0;
}

.link-actions {
  display: flex;
  width: 100%;
  gap: 12rpx;
  margin-top: 18rpx;
}

.link-action {
  height: 56rpx;
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 28rpx;
  background: #fff;
  color: #0b3a75;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
}

.link-action::after {
  border: 0;
}

.expanded-material {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
}

.expanded-title {
  color: #0b3a75;
  font-size: 25rpx;
  font-weight: 700;
}

.expanded-scroll {
  max-height: 260rpx;
  margin-top: 12rpx;
  color: #374151;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-all;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-inline {
  padding: 40rpx 0;
  color: #6b7280;
  text-align: center;
  font-size: 26rpx;
}

.study-shell.landscape-mode {
  display: flex;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: #111827;
}

.study-shell.landscape-mode .video-column {
  flex: 1 1 72%;
  min-width: 0;
  height: 100vh;
}

.study-shell.landscape-mode .video-panel {
  position: static;
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 12px;
  box-sizing: border-box;
}

.study-shell.landscape-mode .video-frame {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.study-shell.landscape-mode .video,
.study-shell.landscape-mode .video-placeholder {
  width: 100%;
  height: auto;
  max-height: 100%;
  min-height: 0;
  border-radius: 8px;
}

.study-shell.landscape-mode .video {
  height: 100%;
}

.study-shell.landscape-mode .content-panel {
  flex: 0 0 28%;
  width: 28%;
  max-width: 340px;
  min-width: 260px;
  height: 100vh;
  overflow-y: auto;
  padding: 12px;
  background: #f6f7f9;
  box-sizing: border-box;
}

.study-shell.landscape-mode .study-toolbar {
  gap: 8px;
  margin-bottom: 10px;
}

.study-shell.landscape-mode .toolbar-title {
  font-size: 14px;
}

.study-shell.landscape-mode .materials-toggle,
.study-shell.landscape-mode .video-tool-button {
  height: 34px;
  padding: 0 14px;
  border-radius: 17px;
  font-size: 13px;
  line-height: 34px;
}

.study-shell.landscape-mode .video-tools {
  right: 10px;
  bottom: 10px;
  gap: 8px;
}

.study-shell.landscape-mode .video-settings {
  right: 10px;
  bottom: 54px;
  left: 10px;
  padding: 10px;
  border-radius: 10px;
}

.study-shell.landscape-mode .setting-row {
  min-height: 40px;
  gap: 8px;
}

.study-shell.landscape-mode .setting-label {
  width: 42px;
  flex-basis: 42px;
  font-size: 13px;
}

.study-shell.landscape-mode .setting-value {
  width: 52px;
  flex-basis: 52px;
  font-size: 12px;
}

.study-shell.landscape-mode .chapter-title {
  font-size: 18px;
  line-height: 1.25;
}

.study-shell.landscape-mode .chapter-subtitle {
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.4;
}

.study-shell.landscape-mode .note-block,
.study-shell.landscape-mode .link-block,
.study-shell.landscape-mode .download-section {
  margin-top: 10px;
  padding: 12px;
  border-radius: 8px;
}

.study-shell.landscape-mode .note-title,
.study-shell.landscape-mode .section-title {
  font-size: 15px;
  line-height: 1.35;
}

.study-shell.landscape-mode .note-text {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.55;
}

.study-shell.landscape-mode .pinch-zoom-container {
  margin-top: 8px;
}

.study-shell.landscape-mode .note-caption {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.45;
}

.study-shell.landscape-mode .link-actions {
  gap: 8px;
  margin-top: 10px;
}

.study-shell.landscape-mode .link-action {
  height: 30px;
  padding: 0 10px;
  border-radius: 15px;
  font-size: 13px;
  line-height: 28px;
}

.study-shell.landscape-mode .expanded-material {
  margin-top: 10px;
  padding: 10px;
  border-radius: 8px;
}

.study-shell.landscape-mode .expanded-title,
.study-shell.landscape-mode .expanded-scroll {
  font-size: 12px;
}

.study-shell.landscape-mode .expanded-scroll {
  max-height: 120px;
  margin-top: 6px;
  line-height: 1.5;
}

.study-shell.materials-closed .content-panel {
  display: none;
}

@media (orientation: landscape) {
  .study-page {
    background: #111827;
  }

  .chapter-title {
    font-size: 32rpx;
  }

  .chapter-subtitle,
  .note-caption {
    font-size: 22rpx;
  }

  .note-title,
  .section-title {
    font-size: 26rpx;
  }

  .note-text {
    font-size: 24rpx;
  }
}
