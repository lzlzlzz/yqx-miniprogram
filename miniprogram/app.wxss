page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.muted {
  color: #6b7280;
}

.primary-button {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  background: #0b3a75;
  color: #fff;
  font-size: 30rpx;
}

.primary-button[disabled] {
  background: #9ca3af;
  color: #f3f4f6;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}
