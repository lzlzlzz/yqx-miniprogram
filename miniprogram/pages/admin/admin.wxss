.admin-page {
  padding-bottom: 48rpx;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.title {
  color: #0b3a75;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle,
.tip,
.mini-tip {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.subtitle {
  margin-top: 10rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
}

.section-title {
  color: #13233a;
  font-size: 31rpx;
  font-weight: 700;
}

.tip {
  margin: 10rpx 0 18rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker {
  min-height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f9fafb;
  box-sizing: border-box;
  color: #13233a;
  font-size: 27rpx;
  line-height: 76rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.mini-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.submit {
  margin-top: 30rpx;
}

.light-button {
  min-width: 156rpx;
  height: 68rpx;
  margin: 0;
  border: 1rpx solid #d7dde6;
  border-radius: 12rpx;
  background: #fff;
  color: #0b3a75;
  line-height: 68rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.code {
  margin-top: 12rpx;
  color: #0b3a75;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
