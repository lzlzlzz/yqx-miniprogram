.back-row {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  margin-bottom: 18rpx;
  color: #0b3a75;
  font-size: 27rpx;
  font-weight: 600;
}

.cover {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #d1d5db;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0b3a75;
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #f7fbff 0%, #e9eef6 46%, #ffe3a8 100%);
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 27rpx;
}

.desc {
  margin-top: 22rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.7;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.access-notice {
  margin-bottom: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #9a5a12;
  font-size: 25rpx;
  line-height: 1.5;
}

.chapter-empty {
  padding: 16rpx 0;
  font-size: 27rpx;
}

.chapter {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-top: 1rpx solid #edf0f3;
}

.chapter:first-of-type {
  border-top: 0;
}

.chapter-index {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: #fff4df;
  color: #f6a21a;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
}

.chapter-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.chapter-title {
  font-size: 28rpx;
  font-weight: 600;
}

.chapter-meta {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.chapter-action {
  margin-left: 18rpx;
  color: #0b3a75;
  font-size: 25rpx;
  font-weight: 600;
}
